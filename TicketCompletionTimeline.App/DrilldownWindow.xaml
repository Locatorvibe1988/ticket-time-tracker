<Window x:Class="TicketCompletionTimeline.App.DrilldownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Completion details" Width="1180" Height="720" MinWidth="850" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F5F8FC">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#0B4F88" CornerRadius="8,8,0,0" Padding="18,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Completion details" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Original CSV fields shown in Excel-style columns. Select and copy cells as needed." Foreground="#CFE8FF" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8E5F0" BorderThickness="1,0,1,1" Padding="14,10">
            <TextBlock x:Name="CountText" Foreground="#526A80" />
        </Border>
        <DataGrid x:Name="DetailsGrid" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="True" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="All" RowHeaderWidth="0" RowHeight="38" Background="White" BorderBrush="#D8E5F0" BorderThickness="1" ClipboardCopyMode="IncludeHeader" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EAF3FB" />
                    <Setter Property="Foreground" Value="#31516D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="10,9" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="#203247" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns />
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" MinWidth="90" Padding="16,8" Click="Close_Click" Background="#E5F0FB" Foreground="#164A78" />
        </StackPanel>
    </Grid>
</Window>
