<Window x:Class="TicketCompletionTimeline.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timeline Settings" Width="620" Height="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F5F8FC">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="34"/></Style>
        <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Timeline settings" FontSize="24" FontWeight="SemiBold" Foreground="#0B4F88" />
            <TextBlock Text="Configure color thresholds, work hours, and optional evidence-based review tools." Foreground="#637A90" Margin="0,6,0,14" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Gap color thresholds" FontSize="15" FontWeight="SemiBold" Foreground="#0B4F88" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Green below" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="GreenBox" Grid.Column="1" Padding="7"/><TextBlock Grid.Column="2" Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#637A90"/>
                            <TextBlock Grid.Row="1" Text="Red above" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="RedBox" Grid.Row="1" Grid.Column="1" Padding="7"/><TextBlock Grid.Row="1" Grid.Column="2" Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#637A90"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CDC close-code colors" FontSize="15" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Enter a 6- or 8-digit hex color (for example, #3B82F6). These colors are used in the timeline nodes and CDC counts." Foreground="#637A90" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <TextBlock Text="001  Blue" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="CdcBlueBox" Grid.Column="1" Padding="7"/>
                            <TextBlock Grid.Column="2" Text="002  Green" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBox x:Name="CdcGreenBox" Grid.Column="3" Padding="7"/>
                            <TextBlock Grid.Row="1" Text="004  White" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="CdcWhiteBox" Grid.Row="1" Grid.Column="1" Padding="7"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="005 / 006  Red" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBox x:Name="CdcRedBox" Grid.Row="1" Grid.Column="3" Padding="7"/>
                            <TextBlock Grid.Row="2" Text="009  Purple" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="CdcPurpleBox" Grid.Row="2" Grid.Column="1" Padding="7"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Other  Black" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBox x:Name="CdcBlackBox" Grid.Row="2" Grid.Column="3" Padding="7"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Normal work hours" FontSize="15" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Everything outside this window is treated as neutral on-call activity and is not scored as a risk signal." Foreground="#637A90" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Workday starts" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="WorkStartBox" Grid.Column="1" Padding="7"/><TextBlock Grid.Column="2" Text="HH:mm" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#637A90"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Workday ends" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="WorkEndBox" Grid.Column="1" Padding="7"/><TextBlock Grid.Column="2" Text="HH:mm" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#637A90"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ReviewSignalsBox" Content="Show operational review signals" FontWeight="SemiBold" Foreground="#31516D" />
                        <TextBlock Text="Shows observable patterns such as long gaps, bursts, batching, and baseline changes. It does not include on-call activity." Foreground="#637A90" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <CheckBox x:Name="ReviewPriorityBox" Content="Show operational review priority" FontWeight="SemiBold" Foreground="#31516D" />
                        <TextBlock Text="Adds Low, Moderate, or High bands to individual user rows. The band is evidence for supervisor review, not a conclusion about intent or performance." Foreground="#637A90" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="Minimum history" FontWeight="SemiBold" Foreground="#31516D" />
                        <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Active days" VerticalAlignment="Center"/><TextBox x:Name="MinActiveDaysBox" Grid.Column="1" Padding="7"/><TextBlock Grid.Column="2" Text="Completions" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBox x:Name="MinCompletionsBox" Grid.Column="3" Padding="7"/>
                        </Grid>
                        <TextBlock Text="Default signal weights" FontWeight="SemiBold" Foreground="#31516D" />
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Longest gap" VerticalAlignment="Center"/><TextBox x:Name="LongGapWeightBox" Grid.Column="1" Padding="6"/><TextBlock Grid.Column="2" Text="Dense burst" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="DenseBurstWeightBox" Grid.Column="3" Padding="6"/>
                            <TextBlock Grid.Row="1" Text="End-of-shift batch" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox x:Name="EndShiftWeightBox" Grid.Row="1" Grid.Column="1" Padding="6" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Baseline change" VerticalAlignment="Center" Margin="12,8,0,0"/><TextBox x:Name="BaselineWeightBox" Grid.Row="1" Grid.Column="3" Padding="6" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Text="Low consistency" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox x:Name="ConsistencyWeightBox" Grid.Row="2" Grid.Column="1" Padding="6" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Volume outlier" VerticalAlignment="Center" Margin="12,8,0,0"/><TextBox x:Name="VolumeWeightBox" Grid.Row="2" Grid.Column="3" Padding="6" Margin="0,8,0,0"/>
                        </Grid>
                        <TextBlock Text="Band thresholds and ratios" FontWeight="SemiBold" Foreground="#31516D" Margin="0,12,0,0" />
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Moderate at" VerticalAlignment="Center"/><TextBox x:Name="ModerateThresholdBox" Grid.Column="1" Padding="6"/><TextBlock Grid.Column="2" Text="High at" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="HighThresholdBox" Grid.Column="3" Padding="6"/>
                            <TextBlock Grid.Row="1" Text="Volume outlier ±" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox x:Name="VolumeRatioBox" Grid.Row="1" Grid.Column="1" Padding="6" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Consistency below" VerticalAlignment="Center" Margin="12,8,0,0"/><TextBox x:Name="ConsistencyRatioBox" Grid.Row="1" Grid.Column="3" Padding="6" Margin="0,8,0,0"/>
                        </Grid>
                        <Button Content="Restore recommended defaults" Background="#E5F0FB" Foreground="#164A78" HorizontalAlignment="Left" Margin="0,14,0,0" Click="RestoreDefaults_Click" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ErrorText" Foreground="#C43D4B" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="90" Background="#E5F0FB" Foreground="#164A78" Click="Cancel_Click" />
            <Button Content="Save settings" MinWidth="130" Background="#1367B1" Foreground="White" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
