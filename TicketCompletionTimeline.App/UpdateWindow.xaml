<Window x:Class="TicketCompletionTimeline.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="560" Height="430" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F5F8FC" ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Update available" FontSize="24" FontWeight="SemiBold" Foreground="#0B4F88" />
            <TextBlock x:Name="VersionText" Foreground="#637A90" Margin="0,5,0,18" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Release notes" FontSize="15" FontWeight="SemiBold" Foreground="#31516D" />
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" Foreground="#203247" Margin="0,8,0,16" />
                    <Border Background="#EAF6EE" BorderBrush="#B8DEC5" BorderThickness="1" CornerRadius="5" Padding="10">
                        <TextBlock Text="Your local archive and settings stay in %LOCALAPPDATA% and are not replaced by an update." TextWrapping="Wrap" Foreground="#476052" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" MinWidth="92" Background="#E5F0FB" Foreground="#164A78" Click="Cancel_Click" />
            <Button Content="Download and install" MinWidth="160" Background="#1367B1" Foreground="White" Click="Install_Click" />
        </StackPanel>
    </Grid>
</Window>
