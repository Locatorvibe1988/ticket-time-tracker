<Window x:Class="TicketCompletionTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TicketCompletionTimeline.App"
        Title="Ticket Time Tracker" Width="1450" Height="900"
        MinWidth="980" MinHeight="680" Background="#F5F8FC"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#203247" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1367B1" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#164A78" />
            <Setter Property="Background" Value="#E5F0FB" />
        </Style>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActiveTabButton" TargetType="Button" BasedOn="{StaticResource TabButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1367B1" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#C43D4B" />
        </Style>
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF3FB" />
            <Setter Property="Foreground" Value="#31516D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="#D2E0ED" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4ECF3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="102" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B4F88" Padding="28,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Ticket Time Tracker" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Daily, weekly, and monthly completion activity by assigned user" Foreground="#CFE8FF" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="＋ Add CSV" Style="{StaticResource PrimaryButton}" Click="AddCsv_Click" />
                    <Button x:Name="HelpButton" Content="? Help" Style="{StaticResource QuietButton}" Click="Help_Click" />
                    <Button Content="Updates" Style="{StaticResource QuietButton}" Click="CheckForUpdates_Click" />
                    <Button Content="⚙ Settings" Style="{StaticResource QuietButton}" Click="Settings_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" HorizontalOffset="-300" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="430" MaxHeight="620" Background="White" BorderBrush="#AFC9DF" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CSV import help" FontSize="20" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Use a standard CSV export. The app keeps the imported session on this computer only." Foreground="#637A90" TextWrapping="Wrap" Margin="0,5,0,16" />
                        <TextBlock Text="Required columns" FontSize="14" FontWeight="SemiBold" Foreground="#203247" />
                        <Border Background="#EAF6EE" BorderBrush="#B8DEC5" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,6,0,14">
                            <StackPanel>
                                <TextBlock Text="Assigned User" FontWeight="SemiBold" Foreground="#1B874C" />
                                <TextBlock Text="The person used to group completion events." Foreground="#476052" TextWrapping="Wrap" Margin="0,2,0,8" />
                                <TextBlock Text="Last Completion" FontWeight="SemiBold" Foreground="#1B874C" />
                                <TextBlock Text="The completion date and time for each CSV row." Foreground="#476052" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Recommended column" FontSize="14" FontWeight="SemiBold" Foreground="#203247" />
                        <Border Background="#FFF7E6" BorderBrush="#E9D39A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,6,0,14">
                            <StackPanel>
                                <TextBlock Text="ID or Ticket ID" FontWeight="SemiBold" Foreground="#A66A00" />
                                <TextBlock Text="Enables conflict detection when additional CSV files are added. It is not required for a first import." Foreground="#6D5A33" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Best results" FontSize="14" FontWeight="SemiBold" Foreground="#203247" />
                        <TextBlock Text="• Keep the first row as column headers.&#10;• Export as UTF-8 CSV when possible.&#10;• Keep one completion event per row.&#10;• Keep user names consistent across files.&#10;• Include ID when you plan to add more files.&#10;• Review the warning message for rejected rows.&#10;• Timestamps without an offset are interpreted as Eastern Time." Foreground="#476052" TextWrapping="Wrap" Margin="0,6,0,14" />
                        <Border Background="#F4F8FC" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="5" Padding="12">
                            <TextBlock Text="Quoted commas, quoted multiline fields, and repeated IDs are supported. Duplicate-management controls are planned for a future release." Foreground="#637A90" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Border Grid.Row="1" Background="White" BorderBrush="#DCE8F2" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="View" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="DailyViewButton" Content="Daily" Style="{StaticResource TabButton}" Click="DailyView_Click" />
                    <Button x:Name="WeeklyViewButton" Content="Weekly" Style="{StaticResource TabButton}" Click="WeeklyView_Click" Visibility="{Binding HasWeeklyDataVisibility}" />
                    <Button x:Name="MonthlyViewButton" Content="Monthly" Style="{StaticResource TabButton}" Click="MonthlyView_Click" Visibility="{Binding HasMonthlyDataVisibility}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel x:Name="DailySelectorPanel" Orientation="Horizontal" Visibility="{Binding DailyViewVisibility}">
                        <TextBlock Text="Day" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="220" ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedDate, Mode=TwoWay}" DisplayMemberPath="Display" Padding="8,5" Height="34" />
                    </StackPanel>
                    <StackPanel x:Name="WeeklySelectorPanel" Orientation="Horizontal" Visibility="{Binding WeeklyViewVisibility}">
                        <TextBlock Text="Week" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="250" ItemsSource="{Binding AvailableWeeks}" SelectedItem="{Binding SelectedWeek, Mode=TwoWay}" DisplayMemberPath="Display" Padding="8,5" Height="34" />
                    </StackPanel>
                    <StackPanel x:Name="MonthlySelectorPanel" Orientation="Horizontal" Visibility="{Binding MonthlyViewVisibility}">
                        <TextBlock Text="Month" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="220" ItemsSource="{Binding AvailableMonths}" SelectedItem="{Binding SelectedMonth, Mode=TwoWay}" DisplayMemberPath="Display" Padding="8,5" Height="34" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#5C7185" VerticalAlignment="Center" Margin="18,0,0,0" />
                <Button Grid.Column="3" Content="Clear Data" Style="{StaticResource DangerButton}" Click="ClearData_Click" IsEnabled="{Binding HasData}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F7FAFD" BorderBrush="#DCE8F2" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="FilterButton" Content="Filters" Style="{StaticResource QuietButton}" Click="FilterButton_Click" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Assigned Team Name" FontWeight="SemiBold" Foreground="#31516D" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="AssignedTeamNameBox" Width="220" Height="30" Padding="7,3" ItemsSource="{Binding AvailableTeams}" SelectedItem="{Binding SelectedTeamName, Mode=TwoWay}" ToolTip="Filter the selected view by assigned team name." />
                </StackPanel>
                <TextBlock x:Name="FilterSummaryText" Grid.Column="2" Text="All users and all activity" Foreground="#637A90" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Content="Clear filters" Style="{StaticResource QuietButton}" Click="ClearFilters_Click" IsEnabled="{Binding HasActiveFilters}" />
            </Grid>
        </Border>

        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="470" MaxHeight="660" Background="White" BorderBrush="#AFC9DF" BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dashboard filters" FontSize="19" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Filters recalculate totals, averages, charts, and review priority." Foreground="#637A90" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <TextBlock Text="Assigned users" FontWeight="SemiBold" Foreground="#31516D" />
                        <Border Background="#F7FAFD" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,6,0,12">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilterUsers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding AssignedUser}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="FilterUser_Changed" Unchecked="FilterUser_Changed" Padding="4,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Minimum completions" Foreground="#31516D" FontWeight="SemiBold"/><TextBox x:Name="MinimumCompletionsBox" TextChanged="FilterTextChanged" Margin="0,4,0,0" Padding="7" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Maximum completions" Foreground="#31516D" FontWeight="SemiBold"/><TextBox x:Name="MaximumCompletionsBox" TextChanged="FilterTextChanged" Margin="0,4,0,0" Padding="7" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Minimum active days" Foreground="#31516D" FontWeight="SemiBold"/><TextBox x:Name="MinimumActiveDaysBox" TextChanged="FilterTextChanged" Margin="0,4,0,0" Padding="7" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Maximum active days" Foreground="#31516D" FontWeight="SemiBold"/><TextBox x:Name="MaximumActiveDaysBox" TextChanged="FilterTextChanged" Margin="0,4,0,0" Padding="7" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Longest-gap band" Foreground="#31516D" FontWeight="SemiBold" />
                        <ComboBox x:Name="GapBandFilterBox" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="FilterSelectionChanged" Margin="0,4,0,10" Padding="7">
                            <ComboBoxItem Content="Any gap band" Tag="Any"/><ComboBoxItem Content="Green" Tag="Green"/><ComboBoxItem Content="Amber" Tag="Amber"/><ComboBoxItem Content="Red" Tag="Red"/>
                        </ComboBox>
                        <TextBlock Text="Activity window" Foreground="#31516D" FontWeight="SemiBold" />
                        <ComboBox x:Name="WorkHoursFilterBox" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="FilterSelectionChanged" Margin="0,4,0,10" Padding="7">
                            <ComboBoxItem Content="Work hours + on-call" Tag="Any"/><ComboBoxItem Content="Work hours only" Tag="WorkHours"/><ComboBoxItem Content="On-call only" Tag="OnCall"/>
                        </ComboBox>
                        <TextBlock Text="Review priority" Foreground="#31516D" FontWeight="SemiBold" />
                        <ComboBox x:Name="ReviewPriorityFilterBox" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="FilterSelectionChanged" Margin="0,4,0,0" Padding="7">
                            <ComboBoxItem Content="Any priority" Tag="Any"/><ComboBoxItem Content="Insufficient data" Tag="InsufficientData"/><ComboBoxItem Content="Low" Tag="Low"/><ComboBoxItem Content="Moderate" Tag="Moderate"/><ComboBoxItem Content="High" Tag="High"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid Grid.Row="3" Margin="20,16">
            <Border x:Name="EmptyState" Background="White" BorderBrush="#B9D4EC" BorderThickness="2" CornerRadius="12" Padding="30" AllowDrop="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Drop CSV here" FontSize="28" FontWeight="SemiBold" Foreground="#0B4F88" HorizontalAlignment="Center" />
                    <TextBlock Text="Drag one or more completion exports onto this window to begin." FontSize="15" Foreground="#637A90" Margin="0,9,0,20" HorizontalAlignment="Center" />
                    <Button Content="Choose a CSV file" Style="{StaticResource PrimaryButton}" Click="AddCsv_Click" HorizontalAlignment="Center" />
                    <TextBlock Text="Your data stays on this computer and is not uploaded." FontSize="12" Foreground="#8295A7" Margin="0,18,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="DashboardScrollViewer" Background="Transparent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Border x:Name="Dashboard" Background="White" BorderBrush="#D8E5F0" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ActivityHeader" Grid.Row="0" Background="#F7FAFD" BorderBrush="#E1EBF3" BorderThickness="0,0,0,1" Padding="16,11">
                        <Grid>
                            <!--
                                Keep the title/actions row separate from the legend row.
                                The old layout put all three horizontal groups in one grid
                                cell and used a top margin to force the legend downward. At
                                smaller window sizes that caused the time-axis header and
                                legend to occupy the same vertical space.
                            -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Completion activity" FontSize="17" FontWeight="SemiBold" Foreground="#0B4F88" />
                                <TextBlock x:Name="TimelineModeText" Text="  •  6 AM – 6 PM workday view" Foreground="#637A90" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Border Background="#EAF6EE" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"><TextBlock Text="Short gap" FontSize="10" Foreground="#1B874C" /></Border>
                                <Border Background="#FFF7E6" CornerRadius="3" Padding="6,2" Margin="0,0,5,0"><TextBlock Text="Moderate gap" FontSize="10" Foreground="#A66A00" /></Border>
                                <Border Background="#FCEBED" CornerRadius="3" Padding="6,2"><TextBlock Text="Long gap" FontSize="10" Foreground="#C43D4B" /></Border>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="OnCallNotice" Text="Off-hours completions available" Foreground="#9A5A12" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Button x:Name="OnCallButton" Content="Show on-call hours" Style="{StaticResource QuietButton}" Click="ShowOnCall_Click" Visibility="Collapsed" />
                                <Button x:Name="CompactButton" Content="Back to workday" Style="{StaticResource QuietButton}" Click="ShowCompact_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="DailyTimelinePanel" Grid.Row="1" Margin="12,0" MaxHeight="420" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                            <Grid Height="40" Background="#EAF3FB">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Assigned User" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                                <Border Grid.Column="1" ClipToBounds="True"><local:TimelineHeaderControl x:Name="TimelineHeader" StartHour="{Binding DataContext.TimelineStartHour, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" EndHour="{Binding DataContext.TimelineEndHour, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></Border>
                            </Grid>
                            <ListBox ItemsSource="{Binding TimelineRows}" ItemContainerStyle="{StaticResource ListItemStyle}" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="White">
                                            <Border Visibility="{Binding TeamHeaderVisibility}" Background="#EAF3FB" BorderBrush="#B9D4EC" BorderThickness="0,1,0,1" Padding="14,6">
                                                <TextBlock Text="{Binding AssignedTeamName}" FontWeight="SemiBold" Foreground="#0B4F88" />
                                            </Border>
                                            <Grid Visibility="{Binding UserRowVisibility}" Height="48">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="#E4ECF3" BorderThickness="0,0,1,1" Padding="14,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding AssignedUser}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AssignedTeamName}" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding CdcCounts}" Margin="6,2,0,2">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Brush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="3,0" Margin="0,0,0,1" ToolTip="{Binding Tooltip}">
                                                                    <TextBlock Text="{Binding Display}" Foreground="{Binding TextBrush}" FontSize="9" FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="#E4ECF3" BorderThickness="0,0,0,1" ClipToBounds="True">
                                                <local:TimelineControl Events="{Binding Events}" GreenBelowMinutes="{Binding DataContext.GreenGapThreshold, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" RedAboveMinutes="{Binding DataContext.RedGapThreshold, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" StartHour="{Binding DataContext.TimelineStartHour, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" EndHour="{Binding DataContext.TimelineEndHour, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" BucketClicked="TimelineControl_BucketClicked" x:Name="UserTimeline" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="WeeklyVisualPanel" Grid.Row="1" Margin="16,12" Visibility="Collapsed">
                        <TextBlock Text="Weekly activity heatmap" FontSize="15" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Click any day cell to open its detailed Daily timeline. Darker blue means more completions; — means no activity." Foreground="#637A90" Margin="0,3,0,10" />
                        <Grid Background="#EAF3FB" Height="34">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Assigned User" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="1" Text="Mon" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="2" Text="Tue" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="3" Text="Wed" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="4" Text="Thu" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="5" Text="Fri" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="6" Text="Sat" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="7" Text="Sun" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WeeklyHeatmapRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="#E4ECF3" BorderThickness="0,0,1,1" Padding="12,0"><TextBlock Text="{Binding AssignedUser}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Border>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding CountText}" Tag="{Binding Date}" ToolTip="{Binding TooltipText}" Background="{Binding Background}" Foreground="{Binding Foreground}" BorderBrush="White" BorderThickness="2" Padding="2" Margin="1" Click="PeriodDayCell_Click" MouseDoubleClick="PeriodDayCell_DoubleClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Daily completion trend" FontSize="14" FontWeight="SemiBold" Foreground="#31516D" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding WeeklyTrendPoints}" Height="145">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding TooltipText}" Margin="3,0">
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="36" Height="{Binding BarHeight}" Background="{Binding Fill}" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center"><TextBlock Text="{Binding ValueText}" FontSize="11" Foreground="#31516D" HorizontalAlignment="Center" /><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#637A90" HorizontalAlignment="Center" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="MonthlyVisualPanel" Grid.Row="1" Margin="16,12" Visibility="Collapsed">
                        <TextBlock Text="Monthly calendar heatmap" FontSize="15" FontWeight="SemiBold" Foreground="#0B4F88" />
                        <TextBlock Text="Click any day to open its detailed Daily timeline. Darker blue means more completions." Foreground="#637A90" Margin="0,3,0,10" />
                        <Grid Background="#EAF3FB" Height="30">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mon" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="1" Text="Tue" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="2" Text="Wed" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="3" Text="Thu" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="4" Text="Fri" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="5" Text="Sat" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                            <TextBlock Grid.Column="6" Text="Sun" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31516D" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MonthlyCalendarCells}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DayText}" Tag="{Binding Date}" ToolTip="{Binding TooltipText}" Background="{Binding Background}" Foreground="{Binding Foreground}" IsEnabled="{Binding IsEnabled}" BorderBrush="White" BorderThickness="2" Padding="4" Margin="1" Height="62" Click="PeriodDayCell_Click" MouseDoubleClick="PeriodDayCell_DoubleClick">
                                        <Button.ContentTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DayText}" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding CountText}" FontSize="11" HorizontalAlignment="Center" /></StackPanel></DataTemplate></Button.ContentTemplate>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Weekly completion trend" FontSize="14" FontWeight="SemiBold" Foreground="#31516D" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding MonthlyTrendPoints}" Height="145">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding TooltipText}" Margin="3,0">
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="48" Height="{Binding BarHeight}" Background="{Binding Fill}" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center"><TextBlock Text="{Binding ValueText}" FontSize="11" Foreground="#31516D" HorizontalAlignment="Center" /><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#637A90" HorizontalAlignment="Center" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ReviewSignalPanel" Grid.Row="2" Margin="16,0,16,12" Visibility="Collapsed">
                        <Border Background="#FFF7E6" BorderBrush="#E9D39A" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Operational review signals" FontSize="14" FontWeight="SemiBold" Foreground="#8A5A00" />
                                <TextBlock Text="These are observable patterns for supervisor review, not conclusions about intent or performance." Foreground="#6D5A33" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <ItemsControl ItemsSource="{Binding ReviewSignalRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#F0D9A8" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding AssignedUser}" FontWeight="SemiBold" Foreground="#31516D" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="#637A90" />
                                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#8A5A00" /><TextBlock Text="{Binding Evidence}" Foreground="#637A90" TextWrapping="Wrap" /></StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#F7FAFD" BorderBrush="#D8E5F0" BorderThickness="0,1,0,1" Padding="16,8">
                        <Grid>
                            <TextBlock x:Name="DailySummaryTitle" Text="Daily summary" FontSize="16" FontWeight="SemiBold" Foreground="#0B4F88" />
                            <TextBlock x:Name="PeriodSummaryTitle" Text="Weekly averages" FontSize="16" FontWeight="SemiBold" Foreground="#0B4F88" Visibility="Collapsed" />
                            <TextBlock Text="Double-click rows for source details  •  click a review band for evidence" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#637A90" FontSize="12" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="DailySummaryGrid" Grid.Row="4" ItemsSource="{Binding UserRows}" MaxHeight="480" MinHeight="110" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeaderWidth="0" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0" MouseDoubleClick="SummaryGrid_MouseDoubleClick">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#EAF3FB" BorderBrush="#B9D4EC" BorderThickness="0,1,0,1" Padding="12,6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0B4F88" /></Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assigned User" Binding="{Binding AssignedUser}" Width="2*" MinWidth="220" />
                            <DataGridTextColumn Header="Team" Binding="{Binding AssignedTeamName}" Width="1.3*" MinWidth="150" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="0.8*" MinWidth="90" />
                            <DataGridTextColumn Header="First" Binding="{Binding FirstText}" Width="1.1*" MinWidth="130" />
                            <DataGridTextColumn Header="Last" Binding="{Binding LastText}" Width="1.1*" MinWidth="130" />
                            <DataGridTemplateColumn Header="Longest gap" Width="1.3*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding LongestGapBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding LongestGapText}" Foreground="{Binding LongestGapTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Review priority" Width="1.4*" MinWidth="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ReviewPriorityText}" Tag="{Binding ReviewPriority}" Background="{Binding ReviewPriorityBrush}" Foreground="{Binding ReviewPriorityTextBrush}" Padding="8,4" HorizontalAlignment="Left" Click="ReviewPriority_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="DailyAggregateFooter" Grid.Row="5" Background="#EAF3FB" BorderBrush="#B9D4EC" BorderThickness="0,1,0,0" Padding="0,2" MouseLeftButtonDown="SummaryAggregate_MouseDoubleClick">
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DailyAggregateRow.AssignedUser}" FontWeight="SemiBold" Foreground="#0B4F88" VerticalAlignment="Center" Padding="14,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DailyAggregateRow.Total}" FontWeight="SemiBold" Foreground="#203247" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DailyAggregateRow.FirstText}" Foreground="#203247" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding DailyAggregateRow.LastText}" Foreground="#203247" VerticalAlignment="Center" />
                            <Border Grid.Column="4" Background="{Binding DailyAggregateRow.LongestGapBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding DailyAggregateRow.LongestGapText}" Foreground="{Binding DailyAggregateRow.LongestGapTextBrush}" FontWeight="SemiBold" /></Border>
                            <TextBlock Grid.Column="5" Text="Aggregate" Foreground="#637A90" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="PeriodSummaryGrid" Grid.Row="4" ItemsSource="{Binding PeriodRows}" MaxHeight="480" MinHeight="110" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" IsReadOnly="True" GridLinesVisibility="None" RowHeaderWidth="0" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0" Visibility="Collapsed" MouseDoubleClick="SummaryGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assigned User" Binding="{Binding AssignedUser}" Width="2*" MinWidth="220" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="0.8*" MinWidth="90" />
                            <DataGridTextColumn Header="Avg/day" Binding="{Binding AverageDailyText}" Width="0.9*" MinWidth="100" />
                            <DataGridTextColumn Header="Avg first" Binding="{Binding AverageFirstText}" Width="1.1*" MinWidth="120" />
                            <DataGridTextColumn Header="Avg last" Binding="{Binding AverageLastText}" Width="1.1*" MinWidth="120" />
                            <DataGridTemplateColumn Header="Avg longest gap" Width="1.4*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding AverageLongestGapBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding AverageLongestGapText}" Foreground="{Binding AverageLongestGapTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Review priority" Width="1.4*" MinWidth="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding ReviewPriorityText}" Tag="{Binding ReviewPriority}" Background="{Binding ReviewPriorityBrush}" Foreground="{Binding ReviewPriorityTextBrush}" Padding="8,4" HorizontalAlignment="Left" Click="ReviewPriority_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="PeriodAggregateFooter" Grid.Row="5" Background="#EAF3FB" BorderBrush="#B9D4EC" BorderThickness="0,1,0,0" Padding="0,2" MouseLeftButtonDown="SummaryAggregate_MouseDoubleClick" Visibility="Collapsed">
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PeriodAggregateRow.AssignedUser}" FontWeight="SemiBold" Foreground="#0B4F88" VerticalAlignment="Center" Padding="14,0" />
                            <TextBlock Grid.Column="1" Text="{Binding PeriodAggregateRow.TotalText}" FontWeight="SemiBold" Foreground="#203247" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding PeriodAggregateRow.AverageDailyText}" Foreground="#203247" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding PeriodAggregateRow.AverageFirstText}" Foreground="#203247" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding PeriodAggregateRow.AverageLastText}" Foreground="#203247" VerticalAlignment="Center" />
                            <Border Grid.Column="5" Background="{Binding PeriodAggregateRow.AverageLongestGapBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding PeriodAggregateRow.AverageLongestGapText}" Foreground="{Binding PeriodAggregateRow.AverageLongestGapTextBrush}" FontWeight="SemiBold" /></Border>
                            <TextBlock Grid.Column="6" Text="Aggregate" Foreground="#637A90" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding WarningText}" Foreground="#9A5A12" Margin="24,0,24,12" TextWrapping="Wrap" />
    </Grid>
</Window>
